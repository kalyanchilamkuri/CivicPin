# Normalise text to LF in the repository. This matters because core.autocrlf
# is commonly on for Windows clones while CI runs on Linux, and the Tailwind
# step compares the committed stylesheet byte-for-byte against a fresh build.
* text=auto eol=lf

# Generated by the Tailwind CLI, which always writes LF. Pinning it keeps the
# CI "stylesheet is up to date" diff from failing on line endings alone.
Code/civicpin_django/static/css/tailwind.css text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
