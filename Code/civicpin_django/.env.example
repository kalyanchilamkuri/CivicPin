# CivicPin (Django) configuration.
# Carried over from the previous Node/Next.js .env files.

# --- Django core -----------------------------------------------------------
# Required when DJANGO_DEBUG=False (the app refuses to start without it).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
TIME_ZONE=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Leave blank for SQLite (db.sqlite3 next to manage.py), or point at Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/civicpin
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Signs the `civicpin_token` cookie. If unset, a separate key is derived
# from DJANGO_SECRET_KEY.
# Use at least 32 bytes of randomness: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=10
# Leave these unset in development; they are only needed for cross-site cookies.
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_SAMESITE=None

# --- Third-party keys (used by the browser via the page templates) ---------
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# --- AI analysis (server-side only; never sent to the browser) -------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Transactional email for signup OTPs -----------------------------------
# Without RESEND_API_KEY, development accepts the fixed code 123456 and
# production refuses to issue a code at all.
RESEND_API_KEY=
RESEND_FROM_EMAIL=CivicPin <onboarding@resend.dev>
OTP_TTL_SECONDS=300

# --- CORS / CSRF (comma separated) -----------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Cache / rate limiting --------------------------------------------------
# Leave blank for a per-process memory cache (fine for one worker). Set it when
# running several workers so OTP codes and rate-limit counters are shared.
# REDIS_URL=redis://localhost:6379/0
# Request budgets per client (DRF rate syntax): 5/min, 100/hour, ...
# THROTTLE_OTP=5/min
# THROTTLE_OTP_VERIFY=15/min
# THROTTLE_AUTH=20/min
# THROTTLE_AI=20/min
# THROTTLE_WRITE=60/min
# OTP_MAX_ATTEMPTS=5
# API_DEFAULT_PAGE_SIZE=500
# API_MAX_PAGE_SIZE=1000
# API_MAX_RADIUS_M=200000
